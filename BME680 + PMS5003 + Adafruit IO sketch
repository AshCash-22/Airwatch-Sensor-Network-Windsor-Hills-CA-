#include <Wire.h>
#include "Adafruit_BME680.h"
#include <PMS.h>
#include <HardwareSerial.h>
#include "AdafruitIO_WiFi.h"

#define WIFI_SSID     "YOUR_WIFI_NAME"
#define WIFI_PASS     "YOUR_WIFI_PASSWORD"
#define IO_USERNAME   "YOUR_ADAFRUIT_IO_USERNAME"
#define IO_KEY        "YOUR_ADAFRUIT_IO_KEY"

AdafruitIO_WiFi io(IO_USERNAME, IO_KEY, WIFI_SSID, WIFI_PASS);

AdafruitIO_Feed *tempFeed = io.feed("temperature");
AdafruitIO_Feed *humidFeed = io.feed("humidity");
AdafruitIO_Feed *pressureFeed = io.feed("pressure");
AdafruitIO_Feed *gasFeed = io.feed("gas");
AdafruitIO_Feed *pm1Feed = io.feed("pm1-0");
AdafruitIO_Feed *pm25Feed = io.feed("pm2-5");
AdafruitIO_Feed *pm10Feed = io.feed("pm10");

Adafruit_BME680 bme;
HardwareSerial pmsSerial(2);
PMS pms(pmsSerial);
PMS::DATA data;

void setup() {
  Serial.begin(115200);
  while (!Serial);

  // BME680 setup
  if (!bme.begin()) {
    Serial.println("Could not find a valid BME680 sensor, check wiring!");
    while (1);
  }
  bme.setTemperatureOversampling(BME680_OS_8X);
  bme.setHumidityOversampling(BME680_OS_2X);
  bme.setPressureOversampling(BME680_OS_4X);
  bme.setIIRFilterSize(BME680_FILTER_SIZE_3);
  bme.setGasHeater(320, 150);

  // PMS5003 setup
  pmsSerial.begin(9600, SERIAL_8N1, 16, 17);

  // Connect to Adafruit IO
  Serial.print("Connecting to Adafruit IO");
  io.connect();
  while (io.status() < AIO_CONNECTED) {
    Serial.print(".");
    delay(500);
  }
  Serial.println();
  Serial.println(io.statusText());
}

void loop() {
  io.run(); // required, keeps connection alive

  bool bmeOK = bme.performReading();
  bool pmsOK = pms.readUntil(data);

  if (bmeOK) {
    Serial.println("--- BME680 ---");
    Serial.print("Temperature = "); Serial.println(bme.temperature);
    Serial.print("Humidity = "); Serial.println(bme.humidity);
    Serial.print("Pressure = "); Serial.println(bme.pressure / 100.0);
    Serial.print("Gas = "); Serial.println(bme.gas_resistance / 1000.0);

    tempFeed->save(bme.temperature);
    humidFeed->save(bme.humidity);
    pressureFeed->save(bme.pressure / 100.0);
    gasFeed->save(bme.gas_resistance / 1000.0);
  } else {
    Serial.println("Failed to read BME680");
  }

  if (pmsOK) {
    Serial.println("--- PMS5003 ---");
    Serial.print("PM1.0 = "); Serial.println(data.PM_AE_UG_1_0);
    Serial.print("PM2.5 = "); Serial.println(data.PM_AE_UG_2_5);
    Serial.print("PM10 = "); Serial.println(data.PM_AE_UG_10_0);

    pm1Feed->save(data.PM_AE_UG_1_0);
    pm25Feed->save(data.PM_AE_UG_2_5);
    pm10Feed->save(data.PM_AE_UG_10_0);
  } else {
    Serial.println("No PMS5003 reading");
  }

  Serial.println();
  delay(35000);
}
